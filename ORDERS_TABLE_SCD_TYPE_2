----CREAET STAGE TABLE 
create or replace table SP_DB1.SP1_SCHEMA.STAGE_ORDER (
O_ORDERKEY	NUMBER(38,0),
O_CUSTKEY	NUMBER(38,0),
O_ORDERSTATUS	VARCHAR(1),
O_TOTALPRICE	NUMBER(12,2),
O_ORDERDATE	DATE,
O_ORDERPRIORITY	VARCHAR(15),
O_CLERK	VARCHAR(15),
O_SHIPPRIORITY	NUMBER(38,0),
O_COMMENT	VARCHAR(79),
INSERT_TIME TIMESTAMP_LTZ);
----CREAET ORDER_DIMENSION TABLE 
create or replace table SP_DB1.SP1_SCHEMA.DIM_ORDER (
S_KEY NUMBER(38,0),
O_ORDERKEY	NUMBER(38,0),
O_CUSTKEY	NUMBER(38,0),
O_ORDERSTATUS	VARCHAR(1),
O_TOTALPRICE	NUMBER(12,2),
O_ORDERDATE	DATE,
O_ORDERPRIORITY	VARCHAR(15),
O_CLERK	VARCHAR(15),
O_SHIPPRIORITY	NUMBER(38,0),
O_COMMENT	VARCHAR(79),
FLAG VARCHAR(1),
START_DATE DATE,
END_DATE DATE,
INSERT_GMT_TIMESTAMP  TIMESTAMP,
UPDATE_GMT_TIMESTAMP  TIMESTAMP
);

-----WRITE A PROCEDURE ORDERS TABLE SCD_TYPE_2
CREATE OR REPLACE PROCEDURE SP_DB1.SP1_SCHEMA.DIM_ORDER_SCD_TYPE2()
RETURNS STRING
LANGUAGE SQL 
AS
BEGIN
TRUNCATE TABLE  SP_DB1.SP1_SCHEMA.STAGE_ORDER;
INSERT INTO SP_DB1.SP1_SCHEMA.STAGE_ORDER
SELECT 
      O_ORDERKEY,
      O_CUSTKEY,
      O_ORDERSTATUS,
      O_TOTALPRICE,
      O_ORDERDATE,
      O_ORDERPRIORITY,
      O_CLERK,
      O_SHIPPRIORITY,
      O_COMMENT,
      CURRENT_TIMESTAMP
FROM SP_DB1.SP1_SCHEMA.TEMP_ORDERS;

-- This query updates the DIM_ORDER table by setting FLAG to 'N', 
-- END_DATE to the previous day, and UPDATE_GMT_TIMESTAMP to the current timestamp 
-- for all records where FLAG is 'Y' and the O_CUSTKEY is present in the STAGE_ORDER table.

UPDATE SP_DB1.SP1_SCHEMA.DIM_ORDER SET FLAG = 'N',END_DATE = (CURRENT_DATE-1),UPDATE_GMT_TIMESTAMP = CURRENT_TIMESTAMP
WHERE FLAG = 'Y'
AND O_CUSTKEY IN (SELECT DISTINCT O_CUSTKEY FROM SP_DB1.SP1_SCHEMA.STAGE_ORDER);
INSERT INTO SP_DB1.SP1_SCHEMA.DIM_ORDER 
SELECT 
      1 AS S_KEY,
      O_ORDERKEY,
      O_CUSTKEY,
      O_ORDERSTATUS,
      O_TOTALPRICE,
      O_ORDERDATE,
      O_ORDERPRIORITY,
      O_CLERK,
      O_SHIPPRIORITY,
      O_COMMENT,
      'Y' AS FLAG,
      CURRENT_DATE AS START_DATE,
      CAST('9999-12-31' AS DATE) AS END_DATE,
      CURRENT_TIMESTAMP AS INSERT_GMT_TIMESTAMP,
      CURRENT_TIMESTAMP AS UPDATE_GMT_TIME_STAMP
      FROM SP_DB1.SP1_SCHEMA.STAGE_ORDER;
EXCEPTION 
      WHEN OTHER THEN 
      RETURN SQLERRM;      
END;
